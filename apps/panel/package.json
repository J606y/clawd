{
  "name": "@clawd/panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:node": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:python": "python3 -B -m unittest discover -s tests -p 'test*.py' && python3 -B -m unittest discover -s sidecar -p 'test*.py'",
    "test:browser": "node scripts/test-gates.mjs --target=browser",
    "test": "node scripts/test-gates.mjs --target=all",
    "verify": "node scripts/test-gates.mjs --target=verify",
    "release": "npm run build && node scripts/publish.mjs",
    "typecheck:react": "tsc --noEmit -p tsconfig.react.json",
    "build:react": "tsc --noEmit -p tsconfig.react.json && vite build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.17",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.64.0",
    "marked": "^18.1.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.28.6",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "react-compiler-healthcheck": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
